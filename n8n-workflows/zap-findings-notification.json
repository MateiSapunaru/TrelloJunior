{
  "name": "TrelloJunior ZAP Findings Notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "trellojunior-zap",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "2b2c3d4e-0001-4b2b-9b2b-000000000001",
      "name": "ZAP Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "trellojunior-zap-notification"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "color",
              "type": "number",
              "value": "={{ $json.body.counts.high > 0 ? 15158332 : ($json.body.counts.medium > 0 ? 15105570 : 3066993) }}"
            },
            {
              "id": "a2",
              "name": "title",
              "type": "string",
              "value": "=ZAP baseline scan - {{ $json.body.repository }}"
            }
          ]
        },
        "options": {}
      },
      "id": "2b2c3d4e-0002-4b2b-9b2b-000000000002",
      "name": "Format Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"embeds\": [\n    {\n      \"title\": \"{{ $json.title }}\",\n      \"color\": {{ $json.color }},\n      \"url\": \"{{ $('ZAP Webhook').item.json.body.run_url }}\",\n      \"description\": \"{{ $('ZAP Webhook').item.json.body.total }} finding(s) on {{ $('ZAP Webhook').item.json.body.branch }}\",\n      \"fields\": [\n        { \"name\": \"High\", \"value\": \"{{ $('ZAP Webhook').item.json.body.counts.high }}\", \"inline\": true },\n        { \"name\": \"Medium\", \"value\": \"{{ $('ZAP Webhook').item.json.body.counts.medium }}\", \"inline\": true },\n        { \"name\": \"Low\", \"value\": \"{{ $('ZAP Webhook').item.json.body.counts.low }}\", \"inline\": true },\n        { \"name\": \"Informational\", \"value\": \"{{ $('ZAP Webhook').item.json.body.counts.informational }}\", \"inline\": true }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "id": "2b2c3d4e-0003-4b2b-9b2b-000000000003",
      "name": "Post to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    }
  ],
  "connections": {
    "ZAP Webhook": {
      "main": [
        [
          {
            "node": "Format Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Message": {
      "main": [
        [
          {
            "node": "Post to Discord",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "instanceId": "trellojunior-portfolio-demo"
  }
}
