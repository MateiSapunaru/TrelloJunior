{
  "name": "TrelloJunior Allure Report Notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "trellojunior-allure",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "3c3d4e5f-0001-4c3c-9c3c-000000000001",
      "name": "Allure Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "trellojunior-allure-notification"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "color",
              "type": "number",
              "value": "={{ ($json.body.counts.failed > 0 || $json.body.counts.broken > 0) ? 15158332 : 3066993 }}"
            },
            {
              "id": "a2",
              "name": "title",
              "type": "string",
              "value": "=E2E results - {{ $json.body.repository }}"
            }
          ]
        },
        "options": {}
      },
      "id": "3c3d4e5f-0002-4c3c-9c3c-000000000002",
      "name": "Format Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"embeds\": [\n    {\n      \"title\": \"{{ $json.title }}\",\n      \"color\": {{ $json.color }},\n      \"url\": \"{{ $('Allure Webhook').item.json.body.run_url }}\",\n      \"description\": \"{{ $('Allure Webhook').item.json.body.total }} test(s) on {{ $('Allure Webhook').item.json.body.branch }} - full Allure report is a build artifact on this run, not hosted (see the README)\",\n      \"fields\": [\n        { \"name\": \"Passed\", \"value\": \"{{ $('Allure Webhook').item.json.body.counts.passed }}\", \"inline\": true },\n        { \"name\": \"Failed\", \"value\": \"{{ $('Allure Webhook').item.json.body.counts.failed }}\", \"inline\": true },\n        { \"name\": \"Broken\", \"value\": \"{{ $('Allure Webhook').item.json.body.counts.broken }}\", \"inline\": true },\n        { \"name\": \"Skipped\", \"value\": \"{{ $('Allure Webhook').item.json.body.counts.skipped }}\", \"inline\": true }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
      "id": "3c3d4e5f-0003-4c3c-9c3c-000000000003",
      "name": "Post to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Allure Webhook": {
      "main": [
        [
          {
            "node": "Format Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Message": {
      "main": [
        [
          {
            "node": "Post to Discord",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "instanceId": "trellojunior-portfolio-demo"
  }
}
